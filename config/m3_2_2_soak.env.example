# Local-only environment for npm run micro-burst:production-soak-m3_2_2.
# Copy to a non-versioned file and set SOAK_ENV_FILE to its absolute path.
APP_ENV=prod
TRADING_MODE=AEGIS_SHADOW
AEGIS_LIVE_ENABLED=0
TELEGRAM_COMMANDS_ENABLED=0

# Leave empty only when the checkout is completely clean. Otherwise provide
# the exact 40-character committed deployment SHA being exercised.
GIT_COMMIT_SHA=

# Supply locally only if this deployment needs read-only startup credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=
