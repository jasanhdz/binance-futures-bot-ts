# Local-only environment for npm run micro-burst:production-soak.
# Copy this to a non-versioned file and set SOAK_ENV_FILE to that path.
APP_ENV=prod
TRADING_MODE=AEGIS_SHADOW
AEGIS_LIVE_ENABLED=0
TELEGRAM_COMMANDS_ENABLED=0

# Required for an official cohort later, but this pre-official soak must not
# claim readiness if the value is absent or not a committed deployment SHA.
GIT_COMMIT_SHA=

# Public market data is sufficient for Micro Burst. If the main runtime needs
# account reads in this deployment, use locally supplied read-only credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=
