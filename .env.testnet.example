# Copy to `.env.testnet` when running `npm run dev:testnet`.

APP_ENV=testnet
IS_TESTNET=1
STRATEGY=ml_advanced

# Binance testnet API credentials
BINANCE_API_KEY=REPLACE_WITH_TESTNET_KEY
BINANCE_API_SECRET=REPLACE_WITH_TESTNET_SECRET

ML_SERVICE_URL=http://127.0.0.1:8000

# Same optimized trio as production but with lower leverage
SYMBOLS="LINKUSDT:20:0.30,SOLUSDT:20:0.25,BNBUSDT:15:0.15"

BOT_INTERVAL_SEC=10
BOT_STAGGER_MS=2000
LEVERAGE=20
CAPITAL_USAGE_PCT=0.30
TP_ROE=1.5
LOG_LEVEL=debug
LOG_PRETTY=1
