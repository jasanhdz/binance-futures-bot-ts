{
  "name": "binance-futures-bot-ts",
  "version": "1.0.0",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "dev:testnet": "DOTENV_CONFIG_PATH=.env.testnet nodemon -r ts-node/register -r dotenv/config src/main.ts",
    "dev:prod": "DOTENV_CONFIG_PATH=.env nodemon -r ts-node/register -r dotenv/config src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:testnet": "DOTENV_CONFIG_PATH=.env.testnet node -r dotenv/config dist/main.js",
    "start:prod": "DOTENV_CONFIG_PATH=.env node -r dotenv/config dist/main.js",
    "test": "vitest run",
    "audit:usdm-readonly": "node -r dotenv/config dist/tooling/audit/binance-usdm-readonly/binance-usdm-readonly-audit.js",
    "audit:usdm-readonly:static": "node dist/tooling/audit/binance-usdm-readonly/binance-usdm-readonly-static-safety.js",
    "market-data:phase-s-soak": "ts-node scripts/shared-market-data-phase-s-soak.ts",
    "analyze:aegis-turbo": "ts-node src/app/analysis/AegisTurboHistoryAnalyzer.ts",
    "audit:regime-guard": "ts-node scripts/aegis/audit_regime_guard.ts",
    "audit:regime-detector": "ts-node scripts/aegis/audit_regime_detector_deep.ts",
    "calibrate:regime-detector": "ts-node scripts/aegis/calibrate_regime_detector.ts",
    "audit:regime-avoid-shadow": "ts-node scripts/aegis/audit_regime_avoid_shadow.ts",
    "audit:regime-engine-v2": "ts-node scripts/aegis/audit_regime_engine_v2.ts",
    "export:regime-engine-v2-ml-dataset": "ts-node scripts/aegis/export_regime_engine_v2_ml_dataset.ts",
    "audit:recent-losses": "ts-node scripts/aegis/audit_recent_losing_trades.ts",
    "audit:long-risk-shadow": "ts-node scripts/aegis/audit_long_risk_shadow.ts",
    "dump:effective-config": "ts-node scripts/aegis/dump_effective_config.ts",
    "micro-burst:analyze-shadow": "ts-node scripts/micro-burst-analyze-shadow.ts",
    "micro-burst:analyze-generic-shadow": "ts-node scripts/micro-burst-analyze-generic-shadow.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^9.4.3",
    "binance-api-node": "^0.12.9",
    "cli-table3": "^3.6.2",
    "dotenv": "^17.2.1",
    "js-yaml": "^4.3.2",
    "node-cron": "^4.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.1",
    "@types/ws": "^8.18.1",
    "@types/yargs": "^17.0.33",
    "diff": "^4.0.4",
    "nanoid": "^3.3.18",
    "nodemon": "^3.1.14",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.26",
    "prettier": "^3.6.2",
    "rollup": "^4.63.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "yargs": "^18.0.0"
  }
}
