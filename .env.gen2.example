# GEN2 canary environment — copy to .env.gen2 (gitignored) and fill in.
# .env.gen2 is loaded by ecosystem.gen2.config.js (PM2) and by gen2_bridge_main.ts.

# Shared HMAC secret between Aegis (python) and the TS bridge. Generate with:
#   openssl rand -hex 32
GEN2_BRIDGE_SECRET=

# Bridge binding / identity (defaults shown)
GEN2_BRIDGE_PORT=8791
GEN2_CANDIDATE_ID=gen2-20260711T202935Z

# Executable symbols are NOT set here — the bridge reads them from the shared
# gen2_config.yaml `symbols` list (the same list Aegis analyzes/ranks), so the
# bridge can never diverge from what Aegis is scoring. Edit gen2_config.yaml
# to change which symbols can execute.

# Execution stays OFF until the owner flips it deliberately (config only:
# gen2_config.yaml execution_enabled; this env var can only DENY, never enable).
GEN2_EXECUTION_ENABLED=false

# Binance USD-M futures credentials.
# - The bridge needs trade-enabled keys ONLY when GEN2_EXECUTION_ENABLED=true.
# - The reconciler works with READ-ONLY keys (recommended to set these always).
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
