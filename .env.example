# FETUSDT:20:0.2,
# 4USDT:20:0.2,
# SNXUSDT:20:0.2,
# MORPHOUSDT:20:0.2,
# "

BOT_INTERVAL_SEC=10
INT_TP_SUP_INTERVAL_MS=3000
INT_TP_SUP_CONCURRENCY=6
LOG_PRETTY=1
LOG_LEVEL="info"
LOG_TO_FILE=1
INT_TP_MIN_ROE=0.25
TIME_STOP_MIN_ROE=0.25

# Optional dedicated testnet credentials
BINANCE_TESTNET_API_KEY=REPLACE_WITH_TESTNET_KEY
BINANCE_TESTNET_API_SECRET=REPLACE_WITH_TESTNET_SECRET

ML_MODELS_ROOT=./models
ML_DATA_DIR=./data/ml/raw
ML_SYMBOL_MODELS=BTCUSDT@5m=BTCUSDT/5m;ETHUSDT@5m=ETHUSDT/5m;XRPUSDT@5m=XRPUSDT/5m
ML_DEFAULT_TIMEFRAME=5m
ML_HISTORY_DAYS=180
ML_TRAIN_HORIZON=12
ML_TRAIN_TARGET_RETURN=0.002
