APP_ENV=prod

# Never commit real credentials. Copy this file to .env and fill values locally.
BINANCE_API_KEY=REPLACE_WITH_PRODUCTION_KEY
BINANCE_API_SECRET=REPLACE_WITH_PRODUCTION_SECRET

LEVERAGE=100
TP_ROE=2.0

STRATEGY=ml_probability
ML_USE_15M_ONLY=1

SYMBOLS="
LINKUSDT:50:0.8,
SOLUSDT:50:0.8,
BNBUSDT:50:0.2,
"

# SYMBOLS="
# BTCUSDT:20:0.8,
