# Copy this file to `.env` for production runs and replace the placeholder values.
# Keys containing secrets (API keys) must be provided manually.

APP_ENV=prod
IS_TESTNET=0
STRATEGY=ml_advanced

# Binance API credentials (production)
BINANCE_API_KEY=REPLACE_WITH_PROD_KEY
BINANCE_API_SECRET=REPLACE_WITH_PROD_SECRET

# ML inference server
ML_SERVICE_URL=http://127.0.0.1:8000

# Format: SYMBOL:LEVERAGE:CAPITAL_SHARE (share in 0-1 range)
SYMBOLS="LINKUSDT:50:0.30,SOLUSDT:50:0.25,BNBUSDT:40:0.15"

BOT_INTERVAL_SEC=10
BOT_STAGGER_MS=2000
LEVERAGE=50
CAPITAL_USAGE_PCT=0.70
TP_ROE=2.0
LOG_LEVEL=info
LOG_PRETTY=1
LOG_TO_FILE=1

# Optional low-funds safeguard
LOW_FUNDS_WALLET_THRESHOLD=50

# Intelligent TP supervisor tweaks (optional)
INT_TP_SUP_INTERVAL_MS=3000
INT_TP_SUP_CONCURRENCY=6
INT_TP_MIN_ROE=0.12
