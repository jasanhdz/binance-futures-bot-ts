# TRXUSDT:30:0.8,
# ETCUSDT:20:0.8,
# SOLUSDT:50:0.8,
# LINKUSDT:50:0.8,
# XLMUSDT:30:0.2,
# ADAUSDT:40:0.2,
# XMRUSDT:30:0.2,
# DOGEUSDT:30:0.2,
# RUNEUSDT:30:0.2,
# DOTUSDT:40:0.2,
# AVAXUSDT:30:0.2,
# UNIUSDT:40:0.2,
# ARBUSDT:30:0.2,
# BATUSDT:30:0.2,
# ALGOUSDT:20:0.2,
